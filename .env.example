# OpenAI API key per generare gli embedding (text-embedding-3-small).
OPENAI_API_KEY=sk-...

# Secret condiviso col client (Next.js). Se impostato, ogni richiesta a /parse
# deve includere l'header `Authorization: Bearer ${PARSER_SHARED_SECRET}`.
# Generare con: openssl rand -hex 32
PARSER_SHARED_SECRET=

# Dimensione massima upload in MB (default 10).
MAX_UPLOAD_MB=10

# Origini CORS consentite, separate da virgola. Vuoto = nessuna origine.
# Es: https://app.example.com,https://staging.example.com
ALLOWED_ORIGINS=
