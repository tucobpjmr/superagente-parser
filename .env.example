# OpenAI API key per generare gli embedding (text-embedding-3-small).
OPENAI_API_KEY=sk-...

# Secret condiviso col client (Next.js). Se impostato, ogni richiesta a /parse
# deve includere l'header `Authorization: Bearer ${PARSER_SHARED_SECRET}`.
# Generare con: openssl rand -hex 32
PARSER_SHARED_SECRET=

# Dimensione massima upload in MB (default 10).
MAX_UPLOAD_MB=10

# Origini CORS consentite, separate da virgola. Vuoto = nessuna origine.
# Es: https://app.example.com,https://staging.example.com
ALLOWED_ORIGINS=

# --- Rate limiting distribuito (opzionale, Upstash Redis REST) ---
# Senza queste variabili il rate limiter è disattivato (no-op).
# Crea un DB su https://console.upstash.com/ e copia URL + token REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Richieste/minuto per IP (default 10).
RATE_LIMIT_PER_MIN=10
# Timeout (secondi) per la chiamata Redis; oltre, fail-open. Default 1.0.
RATE_LIMIT_TIMEOUT_S=1.0

# --- Cache embedding (riusa lo stesso Upstash del rate limiter) ---
# Le embedding sono deterministiche per (modello, testo) → cache per SHA-256.
# TTL in secondi (default 30 giorni). Timeout Redis: default 2s, fail-open.
EMBEDDING_CACHE_TTL_S=2592000
EMBEDDING_CACHE_TIMEOUT_S=2.0
