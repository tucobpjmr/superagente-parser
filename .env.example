# --- Obbligatorie ---
# Chiave API OpenAI per gli embedding (text-embedding-3-small)
OPENAI_API_KEY=sk-...

# --- Sicurezza (consigliate) ---
# Shared secret tra Next.js e parser: genera con `openssl rand -hex 32`.
# Se vuota, l'endpoint /parse è aperto.
PARSER_SHARED_SECRET=

# CORS: origini consentite separate da virgola. Vuoto = CORS disabilitato.
ALLOWED_ORIGINS=

# --- Limiti e rate limiting ---
MAX_UPLOAD_MB=10
PARSE_RATE_LIMIT=10
PARSE_RATE_WINDOW=60

# --- Pipeline parsing ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
OCR_TIMEOUT=60

# --- Embedding ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100

# --- Logging ---
# json (produzione) | text (sviluppo)
LOG_FORMAT=json

# --- Supabase (Fase 2: endpoint /search) ---
# URL e service key del progetto che ospita documenti/document_chunks.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=
