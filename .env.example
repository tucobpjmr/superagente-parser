# --- Obbligatorie ---
# Chiave API OpenAI per gli embedding (text-embedding-3-small)
OPENAI_API_KEY=sk-...

# --- Sicurezza (consigliate) ---
# Shared secret tra Next.js e parser: genera con `openssl rand -hex 32`.
# Se vuota, l'endpoint /parse è aperto.
PARSER_SHARED_SECRET=

# CORS: origini consentite separate da virgola. Vuoto = CORS disabilitato.
ALLOWED_ORIGINS=

# --- Limiti e rate limiting ---
MAX_UPLOAD_MB=10
PARSE_RATE_LIMIT=10
PARSE_RATE_WINDOW=60

# --- Pipeline parsing ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
OCR_TIMEOUT=60

# --- Embedding ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100

# --- Contextual retrieval (Fase 1.3) ---
# Arricchisce l'input dell'embedding con titolo + riassunto + sezione.
# false = comportamento pre-Fase-1 (embedding del solo contenuto del chunk).
CONTEXTUAL_EMBEDDING=true
SUMMARY_TIMEOUT=15

# --- Arricchimento LLM (Fase 1) ---
# Attiva le chiamate LLM di arricchimento (riassunto, discipline, entità).
ENRICHMENT_ENABLED=true
ENRICHMENT_MODEL=gpt-4o-mini
SUMMARY_MAX_INPUT_CHARS=12000

# --- Classificazione multi-disciplina (Fase 1.1/1.2) ---
# Tassonomia chiusa: CSV che sovrascrive quella built-in (vedi enrichment.py).
# DISCIPLINE_TAXONOMY=fiscalita,contrattualistica,assicurazioni,trasporti
# Chunk per chiamata LLM e caratteri max di ogni chunk inviati al classificatore.
ENRICHMENT_BATCH_SIZE=16
ENRICHMENT_CHUNK_CHARS=2000
# Timeout complessivo della classificazione (batch in parallelo).
CLASSIFY_TIMEOUT=45

# --- Logging ---
# json (produzione) | text (sviluppo)
LOG_FORMAT=json

# --- Supabase (Fase 2: endpoint /search) ---
# URL e service key del progetto che ospita documenti/document_chunks.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=

# --- Retrieval multidisciplinare (Fase 2: /search) ---
# Risultati finali post-rerank.
SEARCH_TOP_K=8
# Decomposizione della domanda in sotto-domande (true/false).
SEARCH_DECOMPOSE=true
# Re-ranking finale: llm | none
SEARCH_RERANK=llm
DECOMPOSE_MODEL=gpt-4o-mini
RERANK_MODEL=gpt-4o-mini
SEARCH_HTTP_TIMEOUT=15
SEARCH_LLM_TIMEOUT=20
